{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings.json",
  "title": "Settings",
  "description": "Engine and room settings (architecture.md 3.4, 3.9, 14). The base topic and log level stay in the config entry options.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rooms", "global"],
  "properties": {
    "rooms": {"type": "object", "propertyNames": {"$ref": "common.json#/$defs/RoomId"}, "additionalProperties": {"$ref": "#/$defs/RoomSettings"}},
    "global": {"$ref": "#/$defs/GlobalSettings"}
  },
  "$defs": {
    "Reaction": {"enum": ["fast", "normal", "calm"]},
    "Mode": {"enum": ["rules", "bayes"]},
    "RoomSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["false_alarm_budget", "reaction", "hold_time_s", "auto_light", "light_off_delay_s"],
      "properties": {
        "false_alarm_budget": {"enum": [0.1, 0.3, 1, 3, 10], "description": "False alarms per day the night calibration aims for"},
        "reaction": {"$ref": "#/$defs/Reaction"},
        "hold_time_s": {"type": "integer", "minimum": 10, "maximum": 3600},
        "auto_light": {"type": "boolean", "description": "Not acted on in the MVP (D5)"},
        "light_off_delay_s": {"type": "integer", "minimum": 30, "maximum": 3600}
      }
    },
    "Retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_h", "empty_raw_d", "ticks_d", "events_d"],
      "properties": {
        "raw_h": {"type": "integer", "minimum": 1},
        "empty_raw_d": {"type": "integer", "minimum": 1},
        "ticks_d": {"type": "integer", "minimum": 1},
        "events_d": {"type": "integer", "minimum": 1}
      }
    },
    "GlobalSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensing", "learning", "mode", "tick_s", "use_persons", "persons", "others_may_be_home", "quiet_background", "firmware_channel", "retention"],
      "properties": {
        "sensing": {"type": "boolean", "description": "Whole pipeline on; off makes the room entities unavailable"},
        "learning": {"type": "boolean", "description": "Learn in the background; changes still wait for apply (D4)"},
        "mode": {"$ref": "#/$defs/Mode"},
        "tick_s": {"enum": [0.25, 0.5, 1]},
        "use_persons": {"type": "boolean", "description": "Use person entities for the empty house; off by default (D6)"},
        "persons": {"type": "array", "items": {"type": "string", "pattern": "^person\\."}},
        "others_may_be_home": {"type": "boolean"},
        "quiet_background": {"type": "boolean", "description": "Third group of CFAR background samples (architecture.md 5.2); off (D4)"},
        "firmware_channel": {"type": "boolean", "description": "Use the firmware's line bits as an extra observation"},
        "retention": {"$ref": "#/$defs/Retention"}
      }
    }
  }
}
