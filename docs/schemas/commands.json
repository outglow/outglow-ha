{
  "description": "Websocket commands (architecture.md 3.7). request: the message fields besides id and type; response: the result of a success; event: what a subscription sends after its result. Every command needs an admin (D11).",
  "commands": {
    "outglow/info": {"admin": true, "request": "common.json#/$defs/Empty", "response": "info.json"},
    "outglow/bulbs": {"admin": true, "request": "common.json#/$defs/Empty", "response": "bulbs.json"},
    "outglow/plan/get": {"admin": true, "request": "common.json#/$defs/Empty", "response": "plan.json#/$defs/PlanGetResponse"},
