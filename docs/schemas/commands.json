    "outglow/history/frames": {"admin": true, "request": "history.json#/$defs/HistoryFramesRequest", "response": "history.json#/$defs/HistoryFramesResponse"},
    "outglow/feedback": {"admin": true, "request": "history.json#/$defs/FeedbackRequest", "response": "history.json#/$defs/FeedbackResponse"},
    "outglow/session/start": {"admin": true, "request": "session.json#/$defs/SessionStartRequest", "response": "session.json"},
    "outglow/session/label": {"admin": true, "request": "session.json#/$defs/SessionLabelRequest", "response": "session.json"},
    "outglow/session/stop": {"admin": true, "request": "common.json#/$defs/Empty", "response": "session.json"},
    "outglow/session/get": {"admin": true, "request": "common.json#/$defs/Empty", "response": "session.json#/$defs/SessionGetResponse"},
    "outglow/quality": {"admin": true, "request": "quality.json#/$defs/QualityRequest", "response": "quality.json"},
