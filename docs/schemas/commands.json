    "outglow/settings/set": {"admin": true, "request": "settings.json", "response": "settings.json"},
    "outglow/model/get": {"admin": true, "request": "common.json#/$defs/Empty", "response": "model.json"},
    "outglow/model/snapshots": {"admin": true, "request": "common.json#/$defs/Empty", "response": "model.json#/$defs/SnapshotList"},
    "outglow/model/apply": {"admin": true, "request": "model.json#/$defs/ApplyRequest", "response": "model.json#/$defs/ModelChangeResponse"},
    "outglow/model/discard": {"admin": true, "request": "model.json#/$defs/PendingRequest", "response": "model.json#/$defs/ModelChangeResponse"},
    "outglow/model/rollback": {"admin": true, "request": "model.json#/$defs/RollbackRequest", "response": "model.json#/$defs/ModelChangeResponse"},
