{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.json",
  "title": "WsError",
  "description": "The error object of a failed command (Home Assistant: success false, error {code, message})",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {"$ref": "#/$defs/ErrorCode"},
    "message": {"type": "string"}
  },
  "$defs": {
    "ErrorCode": {"enum": ["rev_conflict", "not_found", "invalid_format", "token_expired", "token_mismatch", "unauthorized", "busy", "unsupported", "no_session", "fetch_failed"]}
  }
}
